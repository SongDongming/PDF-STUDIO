APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=18800
APP_CORS_ORIGINS=["http://localhost:4321"]
APP_DATABASE_URL=postgresql+psycopg://pdfwiki:<set-in-local-env>@localhost:5432/pdfwiki
APP_MINIO_ENDPOINT=localhost:9000
APP_MINIO_ACCESS_KEY=<set-in-local-env>
APP_MINIO_SECRET_KEY=<set-in-local-env>
APP_MINIO_SECURE=false
APP_MINIO_BUCKET=pdfwiki
APP_NEO4J_URI=bolt://localhost:7687
APP_NEO4J_USER=neo4j
APP_NEO4J_PASSWORD=<set-in-local-env>
APP_OCR_BASE_URL=
# 服务端只从受保护文件读取密钥；路径由本变量指定（生产环境不应为纯环境变量密钥）。
APP_PROVIDER_SECRET_FILE=
# DeepSeek（OpenAI 兼容端点）。MOONSHOT_* 为历史命名，实际指向 DeepSeek。
MOONSHOT_API_KEY=<set-in-local-env>
MOONSHOT_BASE_URL=https://api.deepseek.com/v1
MOONSHOT_CHAT_MODEL=deepseek-v4-flash
MOONSHOT_STRUCTURED_MODEL=deepseek-v4-flash
# 智谱 GLM embedding-3（OpenAI 兼容端点）
OPENAI_API_KEY=<set-in-local-env>
OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
OPENAI_EMBEDDING_MODEL=embedding-3
EMBEDDING_DIMENSIONS=1024
# 可选：与业务数据库分离的 PostgreSQL DSN；不填则复用 APP_DATABASE_URL。
APP_LANGGRAPH_DATABASE_URL=
