# Minimal image for the PaddleOCR web-service bridge.
#
# The bridge is a standalone FastAPI app (operations/local/ocr_bridge.py) that
# translates the backend's layout-parsing contract to the official
# PaddleOCR-VL async job API.  It reads PADDLE_OCR_TOKEN from its environment
# (compose injects infra/ocr.env).
#
# NOTE: the module's `__main__` binds 127.0.0.1 (host-process default); in a
# container we run uvicorn explicitly on 0.0.0.0 so the api service can reach it.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app
COPY operations/local/ocr_bridge.py /app/ocr_bridge.py
RUN pip install --no-cache-dir fastapi uvicorn httpx python-multipart

EXPOSE 18111
CMD ["uvicorn", "ocr_bridge:app", "--host", "0.0.0.0", "--port", "18111"]
