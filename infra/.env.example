# 数据服务凭据（Compose 要求必填）
POSTGRES_DB=pdfwiki
POSTGRES_USER=pdfwiki
POSTGRES_PASSWORD=<set-a-local-password>
MINIO_ROOT_USER=<set-a-local-user>
MINIO_ROOT_PASSWORD=<set-a-local-password>
NEO4J_PASSWORD=<set-a-local-password>

# API 行为（均有 Compose 默认值，按需覆盖）
APP_CORS_ORIGINS=["http://localhost:4321"]
APP_OCR_BASE_URL=http://host.docker.internal:18111
APP_COMPILE_MODE=sync
APP_LOCAL_JOB_CONCURRENCY=2
APP_AGENT_RUNTIME=legacy

# 模型提供方（MOONSHOT_* 为历史命名，实际指向 DeepSeek）
MOONSHOT_API_KEY=<set-in-local-env>
MOONSHOT_BASE_URL=https://api.deepseek.com/v1
MOONSHOT_CHAT_MODEL=deepseek-v4-flash
MOONSHOT_STRUCTURED_MODEL=deepseek-v4-flash
OPENAI_API_KEY=<set-in-local-env>
OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
OPENAI_EMBEDDING_MODEL=embedding-3
EMBEDDING_DIMENSIONS=1024
